# ---- 构建产物（zip 由 `pnpm build` 生成，不入库） ----
dist/

# ---- 调研与会话的产物、临时文件（唯一去处是 private/，不入库） ----
# 见 AGENT.md 铁律 13：调研产物、生成草稿、运营报告、抓取中间件一律落 private/，不再用 temp/。
private/
temp/

# ---- WorkBuddy 运行时数据（会话记录、记忆等，不入库） ----
.workbuddy/

# ---- 图标工具的本地副产物（预览副本 / 原图备份，不入库） ----
avatars/.shrunk/
avatars/.originals/

# ---- 依赖与系统文件 ----
node_modules/
.DS_Store
__MACOSX/
*.log

# ---- Python 缓存 ----
__pycache__/
*.pyc
